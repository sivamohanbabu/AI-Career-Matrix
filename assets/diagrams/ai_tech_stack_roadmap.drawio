  <diagram id="ai-tech-stack" name="Modern AI Technology Stack">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="tech_header" value="MODERN AI &amp; GENAI FULL-STACK TECHNOLOGY ARCHITECTURE MAP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#334155;fontColor=#f8fafc;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="1400" height="50" as="geometry"/>
        </mxCell>

        <!-- Layer 1: Hardware & Compute -->
        <mxCell id="layer1" value="LAYER 1: COMPUTE &amp; SILICON FOUNDATION&#xa;• NVIDIA Hopper / Blackwell (H100, B200), Google TPU v5e/v5p, AMD Instinct MI300X, AWS Trainium/Inferentia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#475569;fontColor=#f8fafc;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="1400" height="60" as="geometry"/>
        </mxCell>

        <!-- Layer 2: Runtimes & Kernels -->
        <mxCell id="layer2" value="LAYER 2: LOW-LEVEL RUNTIMES &amp; KERNEL OPTIMIZATION&#xa;• CUDA, Triton, FlashAttention-2/3, TensorRT, vLLM PagedAttention, CUTLASS, Apple Metal / MLX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#64748b;fontColor=#f8fafc;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="190" width="1400" height="60" as="geometry"/>
        </mxCell>

        <!-- Layer 3: Core Frameworks & Model Training -->
        <mxCell id="layer3" value="LAYER 3: DEEP LEARNING &amp; FOUNDATION MODEL TRAINING&#xa;• PyTorch 2.x, JAX, DeepSpeed (ZeRO-3), Megatron-LM, FSDP, Hugging Face Transformers &amp; TRL, Unsloth, Axolotl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e3a8a;strokeColor=#3b82f6;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="270" width="1400" height="60" as="geometry"/>
        </mxCell>

        <!-- Layer 4: Data Engineering & Vector Stores -->
        <mxCell id="layer4" value="LAYER 4: DATA PREPARATION &amp; VECTOR RETRIEVAL&#xa;• Vector DBs: Pinecone, Milvus, Qdrant, Weaviate, pgvector, Chroma | ETL: Apache Spark, Ray Data, Unstructured.io, LlamaParse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#10b981;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="1400" height="60" as="geometry"/>
        </mxCell>

        <!-- Layer 5: Orchestration & Agent Frameworks -->
        <mxCell id="layer5" value="LAYER 5: ORCHESTRATION, RAG &amp; AGENT FRAMEWORKS&#xa;• LangGraph, LlamaIndex, AutoGen, CrewAI, DSPy, Semantic Kernel, Model Context Protocol (MCP), Semantic Router" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="1400" height="60" as="geometry"/>
        </mxCell>

        <!-- Layer 6: Inference Serving & Gateways -->
        <mxCell id="layer6" value="LAYER 6: HIGH-THROUGHPUT SERVING &amp; MODEL GATEWAYS&#xa;• vLLM, TGI, NVIDIA Triton, Ollama, LiteLLM, Cloudflare AI Gateway, Portkey, OpenRouter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#831843;strokeColor=#f43f5e;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="510" width="1400" height="60" as="geometry"/>
        </mxCell>

        <!-- Layer 7: LLMOps, Evals & Security -->
        <mxCell id="layer7" value="LAYER 7: EVALUATION, OBSERVABILITY, RED TEAMING &amp; SAFETY&#xa;• Evals: Ragas, TruLens, DeepEval | Observability: LangSmith, Arize Phoenix, Weights &amp; Biases | Guardrails: NeMo, Llama Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="1400" height="60" as="geometry"/>
        </mxCell>

        <!-- Layer 8: End-User Applications -->
        <mxCell id="layer8" value="LAYER 8: PRODUCTION AI APPLICATIONS&#xa;• Chat-with-Data (PDFs), Coding Assistants, Multi-Agent Automated Workflows, Enterprise Search, Multimodal Vision Systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#22c55e;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="1400" height="60" as="geometry"/>
