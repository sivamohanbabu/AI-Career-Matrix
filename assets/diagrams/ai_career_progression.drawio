<mxfile host="app.diagrams.net" modified="2026-10-29T22:17:00.000Z" agent="Mozilla/5.0" version="24.0.0">
  <diagram id="ai-career-roadmap" name="AI Career & Progression Roadmap">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Header -->
        <mxCell id="header" value="END-TO-END AI CAREER PROGRESSION ROADMAP: FROM ENTRY TO PRINCIPAL / VP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1b4b;strokeColor=#4338ca;fontColor=#ffffff;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="30" width="1400" height="50" as="geometry"/>
        </mxCell>

        <!-- Phase 1: Foundations -->
        <mxCell id="phase1" value="PHASE 1: CORE FOUNDATIONS (Months 0 - 3)&#xa;Mathematics (Linear Algebra, Calc, Prob/Stats)&#xa;Advanced Python, Data Structures &amp; Git&#xa;SQL, Pandas, NumPy, Scikit-learn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="310" height="110" as="geometry"/>
        </mxCell>

        <!-- Phase 2: Deep Learning -->
        <mxCell id="phase2" value="PHASE 2: DEEP LEARNING &amp; NEURAL NETS (Months 4 - 6)&#xa;PyTorch Mechanics, Autograd, Backpropagation&#xa;CNNs, RNNs, Self-Attention &amp; Transformers&#xa;Hugging Face Ecosystem &amp; Pretrained Checkpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="120" width="310" height="110" as="geometry"/>
        </mxCell>

        <!-- Phase 3: GenAI & RAG Specialization -->
        <mxCell id="phase3" value="PHASE 3: GENERATIVE AI &amp; LLMS (Months 7 - 9)&#xa;Vector Embeddings, Indexing &amp; RAG Pipelines&#xa;LangGraph, LlamaIndex, Tool Calling &amp; Agents&#xa;PEFT, LoRA/QLoRA Fine-tuning, Prompt Optimization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;fontColor=#581c87;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="310" height="110" as="geometry"/>
        </mxCell>

        <!-- Phase 4: Production Systems -->
        <mxCell id="phase4" value="PHASE 4: MLOPS &amp; SERVING AT SCALE (Months 10 - 12+)&#xa;High-throughput Serving (vLLM, TensorRT-LLM)&#xa;CI/CD, Evaluation Suites (Ragas, TruLens)&#xa;Kubernetes, Triton, Monitoring &amp; Security Red Teaming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontColor=#14532d;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="120" width="320" height="110" as="geometry"/>
        </mxCell>

        <!-- Connecting Flow -->
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#4338ca;" edge="1" parent="1" source="phase1" target="phase2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#3b82f6;" edge="1" parent="1" source="phase2" target="phase3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;strokeColor=#a855f7;" edge="1" parent="1" source="phase3" target="phase4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Career Tracks (Lower Half) -->
        <mxCell id="track_title" value="SPECIALIZATION TRACKS &amp; SENIORITY LEVEL TARGETS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#64748b;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="270" width="1400" height="40" as="geometry"/>
        </mxCell>

        <!-- Track 1: Applied AI / GenAI -->
        <mxCell id="t1" value="TRACK A: AI / LLM Application Engineer&#xa;• Junior ($110k-$145k) ➔ Senior ($175k-$230k) ➔ Staff/Principal ($260k-$420k+)&#xa;• Key Deliverables: End-to-end multi-agent systems, enterprise RAG, low-latency APIs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="680" height="80" as="geometry"/>
        </mxCell>

        <!-- Track 2: Research Scientist -->
        <mxCell id="t2" value="TRACK B: AI / Foundation Model Research Scientist&#xa;• Postdoc/Research Scientist ($160k-$220k) ➔ Senior ($240k-$380k) ➔ Distinguished ($450k-$1M+)&#xa;• Key Deliverables: Novel model architectures, attention breakthroughs, synthetic data curricula" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="820" y="330" width="680" height="80" as="geometry"/>
        </mxCell>

        <!-- Track 3: MLOps / Systems -->
        <mxCell id="t3" value="TRACK C: AI Systems &amp; MLOps Infrastructure Engineer&#xa;• Systems MLE ($130k-$170k) ➔ Staff Infrastructure ($210k-$310k) ➔ Principal AI Architect ($350k+)&#xa;• Key Deliverables: Distributed multi-node GPU clusters, vLLM orchestration, cost optimization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="680" height="80" as="geometry"/>
        </mxCell>

        <!-- Track 4: AI Product Manager -->
        <mxCell id="t4" value="TRACK D: AI Product Manager &amp; Solutions Strategist&#xa;• Technical PM ($120k-$160k) ➔ Group PM / Director ($220k-$320k) ➔ VP of AI Products ($380k+)&#xa;• Key Deliverables: AI ROI justification, compliance &amp; safety governance, product vision &amp; evals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#0f172a;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="820" y="430" width="680" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="author_footer" value="Curated by Siva Veludurthi | Open in diagrams.net to customize your enterprise AI team plan" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#64748b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="1400" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
